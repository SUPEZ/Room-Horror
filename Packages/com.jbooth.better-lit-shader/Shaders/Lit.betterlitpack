alRoughnessToMipmapLevel(perceptualRoughness, UNITY_SPECCUBE_LOD_STEPS);\n    }\n\n    void SmoothnessToMip_float(float smoothness, out float mip)\n    {\n        float pr = SmoothnessToPerceptualRoughness(smoothness);\n        mip = BakeryPerceptualRoughnessToMipmapLevel(pr);\n    }\n\n    void GetReflectionProjected_float(float3 worldPos, float3 viewDir, float3 normal, float lod, out float3 reflection)\n    {\n        #ifdef _HDRP\n            // TODO\n            reflection = 0;\n        #else\n            float3 reflDir = normalize(reflect(-viewDir, normal));\n\n            //#ifdef _REFLECTION_PROBE_BOX_PROJECTION\n                if (unity_SpecCube0_ProbePosition.w > 0.0f)\n                {\n                    float3 factors = ((reflDir > 0 ? unity_SpecCube0_BoxMax.xyz : unity_SpecCube0_BoxMin.xyz) - worldPos) / reflDir;\n                    float scalar = min(min(factors.x, factors.y), factors.z);\n                    reflDir = reflDir * scalar + (worldPos - unity_SpecCube0_ProbePosition.xyz);\n                }\n            //#endif\n\n            float4 sampleRefl = unity_SpecCube0.SampleLevel(samplerunity_SpecCube0, reflDir, lod);\n\n            #if _URP || _HDRP\n                float3 specCol = DecodeHDREnvironment(sampleRefl, unity_SpecCube0_HDR);\n            #else\n                float3 specCol = DecodeHDR(sampleRefl, unity_SpecCube0_HDR);\n            #endif\n\n            reflection = specCol;\n        #endif\n    }\n\n    // this is the main surface function. Surface is like a surface shader output structure, but\n    // with our new outputs as well.\n    void Ext_SurfaceFunction25 (inout Surface o, ShaderData d)\n    {\n        #if USEBAKERY\n            float3 indDif;\n            float3 indSpec;\n            float4 shadowmask = 1;\n            float3 tangentNormal = o.Normal;\n            float3 worldNormal = o.Normal;\n            #if _WORLDSPACENORMAL\n                tangentNormal = mul((float3x3)d.TBNMatrix, o.Normal);\n            #else\n                worldNormal = mul(o.Normal, (float3x3)d.TBNMatrix);\n            #endif\n\n            float specSmoothness = o.Smoothness;\n            #if _BAKERY_LMSPECMODE_OCCLUDEREFLECTION\n                specSmoothness = _BAKERY_LMSPECMODE_OCCLUDEREFLECTION_SMT;\n            #endif\n            DoBakeryStuff(indDif, indSpec, shadowmask, tangentNormal, worldNormal, specSmoothness, d);\n\n            float mip;\n            SmoothnessToMip_float(o.Smoothness, mip);\n            float3 reflection;\n            GetReflectionProjected_float(d.worldSpacePosition, d.worldSpaceViewDir, worldNormal, mip, reflection);\n\n            #if _URP || _HDRP\n                // Apply fresnel\n                float3 albedo = o.Albedo;\n                float metalness = o.Metallic;\n                float3 normalWorld = worldNormal;\n                float3 viewDir = d.worldSpaceViewDir;\n                float smoothness = o.Smoothness;\n\n                // Convert metalness to specular and \"oneMinusReflectivity\"\n                float3 specularColor = lerp(float3(0.04, 0.04, 0.04), albedo, metalness);\n                float oneMinusDielectricSpec = 1.0 - 0.04;\n                float oneMinusReflectivity = oneMinusDielectricSpec - metalness * oneMinusDielectricSpec;\n\n                // Note: HDRP ShaderGraph will remove metallic parts from diffuse by itself, so we don't do it here\n\n                // Directly apply fresnel and smoothness-dependent grazing term\n                float nv = 1.0f - saturate(dot(normalWorld, viewDir));\n                float nv2 = nv * nv;\n                float fresnel = nv * nv2 * nv2;\n\n                float reflectivity = max(max(specularColor.r, specularColor.g), specularColor.b); // hack, but consistent with Unity code\n                float grazingTerm = saturate(smoothness + reflectivity);\n                float3 fresnel3 = lerp(specularColor, float3(grazingTerm, grazingTerm, grazingTerm), fresnel);\n\n                indSpec *= fresne